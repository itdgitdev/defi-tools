# Shared project environment: merge needed entries into .env; do not overwrite it.
# This is a minimal monitor/rebalancer example, not all project integrations.
ENV=local
LOCAL_DB_HOST=127.0.0.1
LOCAL_DB_PORT=3306
LOCAL_DB_USER=replace-with-mysql-user
LOCAL_DB_PASS=replace-with-mysql-password
LOCAL_DB_NAME=replace-with-database-name
LOCAL_DB_SSL_DISABLED=true

# Binance account alias main-hedge -> MAIN_HEDGE. Repeat for each configured alias.
# Store only the API key and optional secret prefix. Enter the suffix at startup.
BINANCE_MAIN_HEDGE_API_KEY=replace-with-api-key
BINANCE_MAIN_HEDGE_SECRET_PREFIX=

# Rebalancer: match private_key_prefix_env in your wallet config.
# Leave blank to enter all 64 private-key hex characters at startup.
CONFIGURED_REBALANCER_MAIN_PRIVATE_KEY_PREFIX=
# Required for live execution on Base/Arbitrum; use dedicated write RPC keys.
CONFIGURED_REBALANCER_WRITE_RPC_BAS=
CONFIGURED_REBALANCER_WRITE_RPC_ARB=

# Standalone rebalancer read RPCs (configure chains you use).
REBALANCER_READ_RPC_BNB=
REBALANCER_READ_RPC_ETH=
REBALANCER_READ_RPC_BAS=
REBALANCER_READ_RPC_ARB=
# Optional JSON arrays of backup read RPC URLs.
REBALANCER_BACKUP_RPC_BNB=[]
REBALANCER_BACKUP_RPC_ETH=[]
REBALANCER_BACKUP_RPC_BAS=[]
REBALANCER_BACKUP_RPC_ARB=[]
# Additional chain keys supported: LIN, POL, ERA, MON.
# Optional swap aggregator credentials.
SWAPPER_0X_API_KEY=
SWAPPER_OKX_API_KEY=
SWAPPER_OKX_SECRET_KEY=
SWAPPER_OKX_PASSPHRASE=
SWAPPER_KYBER_CLIENT_ID=NftApp
